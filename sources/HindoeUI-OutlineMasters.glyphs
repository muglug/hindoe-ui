            <anchor 140 1762> mark @mark_top0312;
        pos mark ringcomb
            <anchor 7 1968> mark @mark_top0312;
        pos mark tildecomb
            <anchor 8 1835> mark @mark_top0312;
    } mark2mark_top0312;

} mkmk;

# Keep digit script selection stable; this rule does not alter any outline.
feature locl {
    script dev2;
    sub dvZero by dvZero;
    script deva;
    sub dvZero by dvZero;
} locl;
";
};
}
